# Copy this file to .env and fill in your own values.
# NEVER commit a real .env to GitHub — it is in .gitignore for a reason.

# From BotFather in Telegram (never share this with anyone)
BOT_TOKEN=
# Your own Telegram user id (get it from @userinfobot). Only this id can use /admin.
ADMIN_TELEGRAM_ID=
# Public URL of this app's Mini App page, e.g. https://your-app.onrender.com/app/
WEBAPP_URL=
# From your Monetag publisher dashboard (Telegram Mini App rewarded ad zone)
MONETAG_ZONE_ID=
# Optional: shared secret Monetag sends with server-to-server postbacks
MONETAG_POSTBACK_SECRET=
# Test mode: simulate ads with no Monetag account. MUST be false in production.
MONETAG_DEMO_MODE=false

# Economy defaults (admin can also change these with bot commands)
COOLDOWN_SECONDS=300
POINTS_PER_AD=10
KYAT_PER_POINT=1
MIN_WITHDRAW_POINTS=1000
REVENUE_SHARE_PCT=70

# Local database file (SQLite). For Postgres, see README.
DATABASE_PATH=bot.db
PORT=8000
